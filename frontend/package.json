{
  "name": "portal-esporte-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:horto": "node --test tests/horto-utils.test.mjs",
    "test:inscricao": "node --test tests/inscricao-imagem.test.mjs",
    "test:agenda": "node --test tests/agenda.test.mjs",
    "test:administrativo": "node --test tests/admin-documentos.test.mjs",
    "test:suporte": "node --test tests/suporte.test.mjs",
    "test:sessao": "node --test tests/portal-session.test.mjs",
    "test:fotos": "node --test tests/fotos.test.mjs",
    "build:suporte": "node scripts/build-support-knowledge.mjs",
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./public/css/tailwind.css --minify",
    "watch:css": "npm run build:css -- --watch",
    "predev": "npm run build:modalidades && npm run build:suporte && npm run build:css",
    "dev": "vite",
    "prebuild": "npm run build:modalidades && npm run build:suporte && npm run build:css",
    "build": "vite build && node scripts/copy-html-pages.mjs",
    "preview": "vite preview",
    "build:modalidades": "node scripts/build-modality-react.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
